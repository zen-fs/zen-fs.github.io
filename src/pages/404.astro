---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const base = '/src/content/docs/';

/** Every published page, as the URL Astro generates for it. */
const urls = [
	...new Set(
		Object.keys(import.meta.glob('/src/content/docs/**/*.{md,mdx}'))
			.map(file => file.slice(base.length).replace(/\.mdx?$/, ''))
			.filter(slug => !slug.split('/').some(segment => segment.startsWith('_')))
			.map(slug => '/' + slug.replace(/(^|\/)index$/, '$1').toLowerCase())
			.map(url => (url.endsWith('/') ? url : url + '/'))
	),
].sort();
---

<StarlightPage
	frontmatter={{
		title: 'Page not found',
		description: 'The page you were looking for could not be found.',
		template: 'splash',
		editUrl: false,
	}}
>
	<p>That page doesn't exist.</p>

	<p><strong>Looking for API documentation?</strong></p>

	<ul>
		<li><a href="/core/reference/"><code>@zenfs/core</code></a></li>
		<li><a href="/dom/reference/"><code>@zenfs/dom</code></a></li>
		<li><a href="/archives/reference/"><code>@zenfs/archives</code></a></li>
		<li><a href="/cloud/reference/"><code>@zenfs/cloud</code></a></li>
		<li><a href="/emscripten/reference/"><code>@zenfs/emscripten</code></a></li>
		<li><a href="/linux/reference/"><code>@zenfs/linux</code></a></li>
	</ul>
</StarlightPage>

<script is:inline define:vars={{ urls }}>
	const known = new Set(urls);

	/** `<package>/<kind>/<name>` for each reference page, to look up a symbol whose path has changed. */
	const symbols = new Map();
	for (const url of known) {
		const parts = url.split('/').filter(Boolean);
		if (parts.length < 4 || parts[1] !== 'reference') continue;
		const key = `${parts[0]}/${parts.at(-2)}/${parts.at(-1)}`;
		if (!symbols.has(key)) symbols.set(key, url);
	}

	/** TypeDoc's markdown output names two of these differently to its HTML output. */
	const renamed = { enums: 'enumerations', types: 'type-aliases' };

	function target(pathname) {
		const parts = pathname.split('/').filter(Boolean);
		if (!parts.length) return null;

		// A real page, reached with the wrong case or without a trailing slash.
		const lowered = '/' + parts.join('/').toLowerCase() + '/';
		if (known.has(lowered) && lowered !== pathname) return lowered;

		const last = parts.at(-1);
		if (!last.endsWith('.html')) return null;

		// The old per-package landing pages.
		const reference = `/${parts[0]}/reference/`;
		if (parts.length === 2 && ['index.html', 'modules.html', 'hierarchy.html'].includes(last)) {
			return known.has(reference) ? reference : null;
		}

		if (parts.length !== 3) return null;

		// TypeDoc qualified file names by module, e.g. `index.FileSystem.html`.
		const name = last.slice(0, -'.html'.length).split('.').pop().toLowerCase();
		const kind = renamed[parts[1]] ?? parts[1];

		// `projectDocuments` were part of the reference; they are ordinary pages now.
		if (kind === 'documents') {
			const page = `/${parts[0]}/${name}/`;
			return known.has(page) ? page : null;
		}

		return symbols.get(`${parts[0]}/${kind}/${name}`) ?? null;
	}

	const to = target(location.pathname);
	if (to) location.replace(to + location.hash);
</script>
